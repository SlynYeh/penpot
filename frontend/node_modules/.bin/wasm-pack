#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/wudandan/Documents/works/penpot/penpot-2.14.4/frontend/node_modules/.pnpm/wasm-pack@0.13.1/node_modules/wasm-pack/node_modules:/Users/wudandan/Documents/works/penpot/penpot-2.14.4/frontend/node_modules/.pnpm/wasm-pack@0.13.1/node_modules:/Users/wudandan/Documents/works/penpot/penpot-2.14.4/frontend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/wudandan/Documents/works/penpot/penpot-2.14.4/frontend/node_modules/.pnpm/wasm-pack@0.13.1/node_modules/wasm-pack/node_modules:/Users/wudandan/Documents/works/penpot/penpot-2.14.4/frontend/node_modules/.pnpm/wasm-pack@0.13.1/node_modules:/Users/wudandan/Documents/works/penpot/penpot-2.14.4/frontend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../wasm-pack/run.js" "$@"
else
  exec node  "$basedir/../wasm-pack/run.js" "$@"
fi
