{
  "name": "penpot-smart-table-plugin",
  "version": "1.0.0",
  "description": "Penpot plugin: import a JSON-defined table into the canvas as a locked, draggable group, then edit the JSON and re-render.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/clean.mjs && npm run build:ui && npm run build:plugin && node scripts/finalize.mjs",
    "build:ui": "vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "init": "node scripts/dev-server.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@penpot/plugin-styles": "^1.4.2",
    "@penpot/plugin-types": "^1.4.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
